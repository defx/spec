{
  "name": "@defx/spec-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/interpreter",
    "packages/parser"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "sync:grammar": "node scripts/sync-parser-grammar.mjs",
    "validate:interpretation": "npm --workspace @defx/spec-interpreter run validate -- ../../examples/shopping-basket/interpretation.yml",
    "test": "npm run test --workspaces"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "yaml": "^2.9.0"
  }
}
