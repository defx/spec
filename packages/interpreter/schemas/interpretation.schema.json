{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/defx/spec/master/schemas/interpretation.schema.json",
  "title": "Spec Interpretation Document",
  "description": "A reviewable companion interpretation of a .spec file, shaped for deterministic projection into a state-machine model.",
  "type": "object",
  "required": ["kind", "version", "status", "spec", "model"],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "spec-interpretation"
    },
    "version": {
      "const": 1
    },
    "status": {
      "$ref": "#/$defs/reviewStatus"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "spec": {
      "$ref": "#/$defs/specRef"
    },
    "model": {
      "$ref": "#/$defs/model"
    },
    "invariants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/invariant"
      },
      "default": []
    },
    "ambiguities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ambiguity"
      },
      "default": []
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    }
  },
  "$defs": {
    "reviewStatus": {
      "type": "string",
      "enum": ["proposed", "reviewed", "accepted"]
    },
    "termId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "jsonValue": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      ]
    },
    "specRef": {
      "type": "object",
      "required": ["path", "ast"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "grammar": {
          "type": "object",
          "required": ["name", "version"],
          "additionalProperties": false,
          "properties": {
            "name": {
              "const": "spec"
            },
            "version": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "ast": {
          "type": "object",
          "required": ["kind", "version"],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "spec-ast"
            },
            "version": {
              "type": "integer",
              "minimum": 1
            },
            "path": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "sourceRef": {
      "type": "object",
      "required": ["scenario"],
      "additionalProperties": false,
      "properties": {
        "scenario": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "type": "string",
          "enum": ["given", "when", "then"]
        },
        "clause": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reviewable": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/reviewStatus"
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          },
          "default": []
        }
      }
    },
    "model": {
      "type": "object",
      "required": ["id", "initial", "states", "events", "transitions"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/termId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "initial": {
          "$ref": "#/$defs/termId"
        },
        "context": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/contextEntry"
          },
          "default": {}
        },
        "states": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/state"
          },
          "minItems": 1
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          },
          "default": []
        },
        "transitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transition"
          },
          "default": []
        },
        "status": {
          "$ref": "#/$defs/reviewStatus"
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          },
          "default": []
        }
      }
    },
    "contextEntry": {
      "type": "object",
      "required": ["type", "initial"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["string", "number", "boolean", "enum", "expression", "object", "array"]
        },
        "initial": {
          "$ref": "#/$defs/jsonValue"
        },
        "description": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonValue"
          },
          "default": []
        },
        "status": {
          "$ref": "#/$defs/reviewStatus"
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          },
          "default": []
        }
      }
    },
    "state": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/termId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": ["atomic", "compound", "parallel", "final"],
          "default": "atomic"
        },
        "description": {
          "type": "string"
        },
        "initial": {
          "$ref": "#/$defs/termId"
        },
        "states": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/state"
          },
          "default": []
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/termId"
          },
          "default": []
        },
        "status": {
          "$ref": "#/$defs/reviewStatus"
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          },
          "default": []
        }
      }
    },
    "event": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/termId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "phrase": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "payload": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/payloadField"
          },
          "default": []
        },
        "status": {
          "$ref": "#/$defs/reviewStatus"
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          },
          "default": []
        }
      }
    },
    "payloadField": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/termId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      }
    },
    "transition": {
      "type": "object",
      "required": ["id", "name", "from", "event", "sourceRefs"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/termId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "$ref": "#/$defs/termId"
        },
        "event": {
          "$ref": "#/$defs/termId"
        },
        "to": {
          "oneOf": [
            {
              "$ref": "#/$defs/termId"
            },
            {
              "type": "null"
            }
          ]
        },
        "guard": {
          "$ref": "#/$defs/condition"
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effect"
          },
          "default": []
        },
        "status": {
          "$ref": "#/$defs/reviewStatus"
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          },
          "minItems": 1
        }
      }
    },
    "condition": {
      "oneOf": [
        {
          "$ref": "#/$defs/stateCondition"
        },
        {
          "$ref": "#/$defs/contextCondition"
        },
        {
          "$ref": "#/$defs/allCondition"
        },
        {
          "$ref": "#/$defs/anyCondition"
        },
        {
          "$ref": "#/$defs/notCondition"
        }
      ]
    },
    "stateCondition": {
      "type": "object",
      "required": ["state"],
      "additionalProperties": false,
      "properties": {
        "state": {
          "$ref": "#/$defs/termId"
        }
      }
    },
    "contextCondition": {
      "type": "object",
      "required": ["context", "operator", "value"],
      "additionalProperties": false,
      "properties": {
        "context": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "type": "string",
          "enum": [
            "equals",
            "notEquals",
            "greaterThan",
            "greaterThanOrEquals",
            "lessThan",
            "lessThanOrEquals",
            "includes",
            "doesNotInclude",
            "exists",
            "doesNotExist"
          ]
        },
        "value": {
          "$ref": "#/$defs/jsonValue"
        }
      }
    },
    "allCondition": {
      "type": "object",
      "required": ["all"],
      "additionalProperties": false,
      "properties": {
        "all": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          },
          "minItems": 1
        }
      }
    },
    "anyCondition": {
      "type": "object",
      "required": ["any"],
      "additionalProperties": false,
      "properties": {
        "any": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          },
          "minItems": 1
        }
      }
    },
    "notCondition": {
      "type": "object",
      "required": ["not"],
      "additionalProperties": false,
      "properties": {
        "not": {
          "$ref": "#/$defs/condition"
        }
      }
    },
    "effect": {
      "oneOf": [
        {
          "$ref": "#/$defs/assignEffect"
        },
        {
          "$ref": "#/$defs/actionEffect"
        }
      ]
    },
    "assignEffect": {
      "type": "object",
      "required": ["assign", "value"],
      "additionalProperties": false,
      "properties": {
        "assign": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "$ref": "#/$defs/jsonValue"
        }
      }
    },
    "actionEffect": {
      "type": "object",
      "required": ["action"],
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/termId"
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          },
          "default": {}
        }
      }
    },
    "invariant": {
      "type": "object",
      "required": ["id", "name", "when", "assert", "sourceRefs"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/termId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "when": {
          "$ref": "#/$defs/condition"
        },
        "assert": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          },
          "minItems": 1
        },
        "status": {
          "$ref": "#/$defs/reviewStatus"
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          },
          "minItems": 1
        }
      }
    },
    "ambiguity": {
      "type": "object",
      "required": ["id", "phrase", "note"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/termId"
        },
        "phrase": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          },
          "default": []
        }
      }
    }
  }
}
